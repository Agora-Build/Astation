# Station Relay Server - Environment Variables
# Copy this file to .env and configure for your environment

# ============================================
# CORS Configuration
# ============================================
# Allowed origin for CORS (production: your domain, dev: *)
CORS_ORIGIN=https://station.agora.build

# Public base URL used to generate share links (recommended behind reverse proxies/CDN)
PUBLIC_BASE_URL=https://station.agora.build

# Account authentication: Auth signs access tokens; Station verifies JWKS locally.
# Configure all three. Audience must equal PUBLIC_BASE_URL exactly (no slash).
# For dev Auth use https://auth.dev.agora.build after registering this resource.
ACCOUNT_OIDC_ISSUER=https://auth.agora.build
ACCOUNT_OIDC_AUDIENCE=https://station.agora.build
ACCOUNT_OIDC_REQUIRED_SCOPE=astation.remote

# Custom Station only: temporary public proof from Portal > Stations > Add Station.
# Exposed as text/plain at /.well-known/agora-build-station; remove after proof.
# STATION_REGISTRATION_CHALLENGE=<Portal-generated-base64url-value>

# For development (allows all origins - WARNING: security risk)
# CORS_ORIGIN=*

# ============================================
# Server Configuration
# ============================================
# Server port (default: 3000)
PORT=3000

# ============================================
# Logging Configuration
# ============================================
# Log level: error, warn, info, debug, trace
# Production: info
# Development: debug
RUST_LOG=info

# ============================================
# Multi-replica (shared relay state)
# ============================================
# Redis/Valkey for rooms, pairing/voice/RTC sessions and rate limits.
# Unset: in-memory, and the relay must run as exactly one replica.
# REDIS_URL=redis://default:<password>@<valkey-host>:6379
# How many relay replicas this deployment runs. >1 without REDIS_URL
# refuses to start.
# RELAY_REPLICAS_EXPECTED=1
